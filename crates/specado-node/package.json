{
  "name": "specado",
  "version": "0.2.2",
  "main": "lib.js",
  "types": "lib.d.ts",
  "files": [
    "lib.d.ts",
    "lib.js",
    "index.js",
    "index.d.ts",
    "*.node",
    "npm/**",
    "providers/**"
  ],
  "napi": {
    "name": "specado",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "bundle:providers": "node ./scripts/copy-providers.mjs",
    "clean:providers": "node ./scripts/clean-providers.mjs",
    "prepack": "npm run bundle:providers && npx --yes @napi-rs/cli@2.18.4 prepublish -t npm",
    "test": "node --test"
  },
  "dependencies": {
    "@napi-rs/cli": "^2.18.4",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "specado-win32-x64-msvc": "0.2.2",
    "specado-darwin-x64": "0.2.2",
    "specado-linux-x64-gnu": "0.2.2",
    "specado-darwin-arm64": "0.2.2",
    "specado-linux-arm64-gnu": "0.2.2",
    "specado-linux-x64-musl": "0.2.2"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib.d.ts",
      "default": "./lib.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  }
}