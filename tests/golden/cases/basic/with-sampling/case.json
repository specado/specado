{
  "provider": "openai/gpt-5/base.yaml",
  "prompt": {
    "version": "1",
    "messages": [
      {"role": "user", "content": "Write a whimsical story about a robot baker."}
    ],
    "sampling": {
      "temperature": 0.8,
      "top_p": 0.95,
      "frequency_penalty": 0.5,
      "seed": 1337
    },
    "metadata": {
      "openai_model": "gpt-5",
      "openai_max_output_tokens": 512,
      "openai_text_verbosity": "balanced",
      "openai_reasoning_effort": "low"
    }
  },
  "description": "Sampling parameters mapped for OpenAI responses with unsupported fields reported."
}
